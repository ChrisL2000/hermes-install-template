# Copy to .env and adjust. Read by scripts/deploy.sh and by docker compose.

# --- host -------------------------------------------------------------------
# GID of the `render` group on this host:  getent group render | cut -d: -f3
RENDER_GID=992
# Which Level Zero device is the B70 (0 = first discrete GPU with COMPOSITE hierarchy)
ZE_AFFINITY_MASK=0
# Host port for the OpenAI-compatible API
HOST_PORT=8081

# --- upstream source (pinned) ----------------------------------------------
B70_REPO_URL=https://github.com/Danmoreng/intel-b70-qwen38-vllm.git
B70_REPO_COMMIT=ed47c5b84614f5654440355b12fa61b6eea8ee5e
# Where to clone it (runtime/request_defaults.py is bind-mounted from here)
B70_REPO_DIR=/home/CHANGEME/src/intel-b70-qwen38-vllm

# --- image / model (pinned) --------------------------------------------------
VLLM_IMAGE=local/b70-qwen38-vllm:base-dev
MODEL_ID=mikeinnyc/Qwen3.8-27B-GPTQ-Int4-sym-G128-MTP-BF16
MODEL_REVISION=a47b0c6f0d756bc394c4cc629d5b0ded1acc7001
SERVED_MODEL_NAME=Qwen3.8-27B

# --- docker objects ------------------------------------------------------------
COMPOSE_PROJECT=vllm-b70-qwen38-gptq
CONTAINER_NAME=vllm-b70-qwen38-gptq
HF_CACHE_VOLUME=vllm-huggingface-cache
VLLM_NETWORK=vllm-network

# --- tuned serving profile (see hermes-vllm-operations-tuning) ---------------
MAX_MODEL_LEN=200704
GPU_MEMORY_UTILIZATION=0.965
MAX_NUM_SEQS=4
SPECULATIVE_TOKENS=4
